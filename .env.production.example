# ==========================================
# PRODUCTION ENVIRONMENT VARIABLES
# ==========================================
# Make a copy of this file and name it .env for production

# --- Security ---
# Generate a strong 32+ byte string (e.g. `openssl rand -hex 32`)
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_VALUE
# Comma-separated list of allowed origins. Usually just your frontend domain.
BACKEND_CORS_ORIGINS=https://your-production-domain.com

# --- Database ---
# The password for the postgres database user
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_SECURE_PASSWORD
# The full connection string for FastAPI to reach postgres (internal to docker network)
DATABASE_URL=postgresql+asyncpg://postgres:${POSTGRES_PASSWORD}@postgres:5432/lost_and_found

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Email (SMTP via SendGrid, AWS SES, or similar) ---
# MUST be set to False in production
MOCK_SMTP=False
SUPPORT_EMAIL=support@your-production-domain.com
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=YOUR_SMTP_PASSWORD
SMTP_TLS=True
SMTP_FROM=noreply@your-production-domain.com

# --- Storage (Local by default, or S3) ---
STORAGE_TYPE=local
# If using S3:
# STORAGE_TYPE=s3
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_S3_BUCKET=your_bucket_name
# AWS_REGION=us-east-1

# --- Grafana ---
GF_SECURITY_ADMIN_PASSWORD=CHANGE_THIS_GRAFANA_PASSWORD
